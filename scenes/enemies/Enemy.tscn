display_name = "Slime"
max_hp = 50
atk = 5
def = 1
move_speed = 40.0
attack_range = 35.0
attack_cooldown = 1.5
gold_reward = 10
exp_reward = 5
[node name="Body" type="ColorRect" parent="."]
offset_left = -15.0
offset_top = -36.0
offset_right = 15.0
offset_bottom = 0.0
color = Color(0.85, 0.25, 0.2, 1)

[node name="Label" type="Label" parent="."]
offset_left = -24.0
offset_top = -56.0
offset_right = 24.0
offset_bottom = -38.0
text = "ENEMY"
horizontal_alignment = 1
