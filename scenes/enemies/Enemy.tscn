; Godot 4 scene file.
; Enemy test scene using EnemyCharacter (scripts/enemies/Enemy.gd).
; enemy_id is left empty so stats come directly from Inspector exports,
; not from DataManager — making this scene self-contained for testing.

[gd_scene load_steps=3 format=3 uid="uid://enemy_character_test"]

[ext_resource type="Script" path="res://scripts/enemies/Enemy.gd" id="1_enemy_character_script"]

[sub_resource type="RectangleShape2D" id="RectangleShape2D_enemy_char"]
size = Vector2(30, 36)

[node name="Enemy" type="CharacterBody2D"]
